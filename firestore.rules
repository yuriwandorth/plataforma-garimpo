rules_version = '2';
// Regras de segurança da Plataforma Garimpo.
// Cada consultoria (tenant) só enxerga os próprios dados.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function member(t) { return signedIn() && exists(/databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid)); }
    function memberDoc(t) { return get(/databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid)).data; }
    function active(t) { return member(t) && memberDoc(t).active == true; }
    function owner(t) { return active(t) && memberDoc(t).role == 'owner'; }
    // getAfter: enxerga o lote que cria consultoria + membro + perfil de uma vez
    function tenantOwnerUid(t) { return getAfter(/databases/$(database)/documents/tenants/$(t)).data.ownerUid; }
    function invited(t) {
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/invites/$(email()))
        && get(/databases/$(database)/documents/invites/$(email())).data.tenantId == t;
    }

    // Perfil do usuário: aponta para a consultoria dele
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && (
          // dono criando a própria consultoria
          (request.resource.data.role == 'owner' && tenantOwnerUid(request.resource.data.tenantId) == uid)
          // membro aceitando convite
          || (request.resource.data.role == 'staff' && invited(request.resource.data.tenantId))
        );
      allow update, delete: if false;
    }

    // Convites do time (id = e-mail em minúsculas)
    match /invites/{inviteEmail} {
      allow read: if signedIn() && (email() == inviteEmail || owner(resource.data.tenantId));
      allow create, update: if owner(request.resource.data.tenantId);
      allow delete: if owner(resource.data.tenantId) || (signedIn() && email() == inviteEmail);
    }

    // Links rastreados (/r/?l=slug): públicos para quem clica; só o dono da consultoria grava
    match /go/{slug} {
      allow get: if resource.data.active == true || active(resource.data.tenantId);
      allow list: if false;
      allow create: if owner(request.resource.data.tenantId);
      allow update, delete: if owner(resource.data.tenantId) && (!('tenantId' in request.resource.data) || request.resource.data.tenantId == resource.data.tenantId);
    }

    match /tenants/{t} {
      allow read: if active(t);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if owner(t) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /members/{uid} {
        allow read: if active(t);
        // o dono cria o próprio registro ao abrir a consultoria; convidado entra pelo convite
        allow create: if signedIn() && request.auth.uid == uid && (
          (tenantOwnerUid(t) == uid && request.resource.data.role == 'owner')
          || (invited(t) && request.resource.data.role == 'staff')
        );
        allow update: if owner(t);
        allow delete: if false; // desligar = active false
      }

      // Auditoria: só acrescenta, ninguém altera
      match /audit/{id} {
        allow read: if owner(t);
        allow create: if active(t) && request.resource.data.by == request.auth.uid;
        allow update, delete: if false;
      }

      // Configurações comerciais: só o dono altera
      // Diário: só o(a) dono(a)
      match /journal/{id} {
        allow read, write: if owner(t);
      }
      match /channels/{id} {
        allow read: if active(t);
        // tenantOwnerUid usa getAfter: permite criar os canais padrão no mesmo lote que abre a consultoria
        allow write: if owner(t) || tenantOwnerUid(t) == request.auth.uid;
      }

      // Checkout: o link ativo é público (a aluna abre sem login)
      match /checkouts/{id} {
        allow read: if active(t) || resource.data.active == true;
        allow create, update: if active(t);
        allow delete: if owner(t);
      }

      // Cupons: a aluna consulta um código por vez (não consegue listar); a equipe gerencia
      match /coupons/{code} {
        allow get: if active(t) || resource.data.active == true;
        allow list: if active(t);
        allow create, update: if active(t) && request.resource.data.pct is int && request.resource.data.pct >= 1 && request.resource.data.pct <= 90;
        allow delete: if owner(t);
      }

      // Pedidos do checkout: a aluna (sem login) só cria o pedido e registra a volta do pagamento.
      // Ninguém de fora lê pedidos. Pago só é marcado pela equipe, depois de conferir na InfinitePay.
      match /orders/{id} {
        function link() { return get(/databases/$(database)/documents/tenants/$(t)/checkouts/$(request.resource.data.checkoutId)).data; }
        function coupon() { return get(/databases/$(database)/documents/tenants/$(t)/coupons/$(request.resource.data.couponCode)).data; }
        allow read: if active(t);
        allow create: if active(t) || (
          request.resource.data.keys().hasOnly(['checkoutId', 'title', 'planId', 'planName', 'productId', 'period', 'price', 'listPrice', 'couponCode', 'discountPct', 'name', 'email', 'phone', 'cpf', 'ref', 'acceptedTerms', 'termsText', 'acceptedAt', 'userAgent', 'status', 'createdAt'])
          && request.resource.data.status == 'aguardando'
          && request.resource.data.acceptedTerms == true
          && link().active == true
          // sem cupom: preço cheio; com cupom: cupom ativo e desconto calculado igual ao da página
          && (
            (!('couponCode' in request.resource.data) && request.resource.data.price == link().price)
            || ('couponCode' in request.resource.data
              && coupon().active == true
              && request.resource.data.discountPct == coupon().pct
              && request.resource.data.listPrice == link().price
              && request.resource.data.price == math.round(link().price * (100 - coupon().pct)) / 100.0)
          )
          && request.resource.data.planId == link().planId
          && request.resource.data.termsText == link().terms
          && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 120
          && request.resource.data.email is string && request.resource.data.email.size() <= 160
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        );
        allow update: if active(t) || (
          resource.data.status == 'aguardando'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkUrl', 'ret', 'status', 'updatedAt'])
          && request.resource.data.status in ['aguardando', 'retornou']
        );
        allow delete: if owner(t);
      }

      // Cliques nos links rastreados: quem clica (sem login) só cria um registro mínimo; ninguém de fora lê
      match /clicks/{id} {
        function go() { return get(/databases/$(database)/documents/go/$(request.resource.data.slug)).data; }
        allow read: if active(t);
        allow create: if request.resource.data.keys().hasOnly(['slug', 'originId', 'day', 'at'])
          && request.resource.data.slug is string && request.resource.data.slug.size() <= 60
          && request.resource.data.day is string && request.resource.data.day.size() == 10
          && request.resource.data.at is int
          && go().tenantId == t && go().active == true && go().originId == request.resource.data.originId;
        allow update: if false;
        allow delete: if owner(t);
      }

      // Dados do dia a dia: todo membro ativo
      match /{col}/{id} {
        allow read: if active(t) && col in ['clients', 'products', 'plans', 'sales', 'goals', 'offers', 'influencers', 'commissionModels', 'influencerMonths', 'ambassadors', 'okrs', 'activities', 'campaigns', 'knowledge', 'assessments', 'leads'];
        allow create, update: if active(t) && col in ['clients', 'products', 'plans', 'sales', 'goals', 'offers', 'influencers', 'commissionModels', 'influencerMonths', 'ambassadors', 'okrs', 'activities', 'campaigns', 'knowledge', 'assessments', 'leads'];
        // exclusão definitiva só do dono (clientes usam exclusão lógica)
        allow delete: if owner(t) && col in ['products', 'plans', 'sales', 'goals', 'clients', 'offers', 'influencers', 'commissionModels', 'influencerMonths', 'ambassadors', 'okrs', 'activities', 'campaigns', 'knowledge', 'assessments', 'leads'];
      }
    }
  }
}
